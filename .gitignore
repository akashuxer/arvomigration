node_modules

# Anchored to the repo root on purpose. A bare `dist` matches a directory of
# that name at ANY depth, which silently excluded vendor/arvo/*/dist -- the
# design-system build the app resolves against -- and CI failed on imports that
# looked present locally.
/dist
/dist-ssr
*.local

